/backups/
/dumps/
*.dump
*.backup
*.sql.gz
*.xlsx
*.xls
*.csv
# ferramentas e rascunhos locais
/.claude/
/scripts/archive/
.vscode/
*.log
Thumbs.db
desktop.ini
