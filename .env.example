# Exemplo de configuração (copie para .env e preencha). Em produção use as variáveis de ambiente da plataforma.
DATABASE_URL=postgresql://usuario:senha@host:5432/pacifil
SESSION_SECRET=troque-por-um-segredo-aleatorio-de-48-caracteres
# endereço público do sistema (links dos e-mails de senha). Ex.: https://loadingplanner.vercel.app
APP_URL=
# Usuário administrador inicial (npm run db:seed)
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
# Assistente IA (somente servidor)
ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5-5
AI_EFFORT=low
AI_RATE_PER_MIN=8
AI_RATE_PER_DAY=300

# --- E-mail (envio dos PDFs) — Microsoft 365 / Outlook ---
# O administrador preenche estes valores no .env do servidor (nunca no código nem no chat).
# Na conta do Microsoft 365, o "SMTP autenticado" precisa estar habilitado para a caixa de correio
# (Centro de administração → Usuários → a conta → Email → Gerenciar aplicativos de email → SMTP autenticado).
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=exportacao@pacifil.com.br
SMTP_PASS=
SMTP_FROM="Pacifil Exportação <exportacao@pacifil.com.br>"
